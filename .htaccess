DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /BM-Monitor/

  # Редирект API запросов на PHP контроллер
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Если файл или папка существует, отдаем как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Все остальные запросы на index.html для Angular HTML5 роутинга
  RewriteRule ^ index.html [L]
</IfModule>

# Разрешение доступа и отключение листинга файлов
Options -Indexes +FollowSymLinks
AddDefaultCharset UTF-8
Header set Access-Control-Allow-Origin "*"
