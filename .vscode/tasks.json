{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BM-Monitor: Start Server (Watch mode)",
      "type": "shell",
      "command": "node --watch server.js",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "BM-Monitor: Trigger Daily Crawl",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:4300/api/crawl | json_pp || echo 'Done'",
      "problemMatcher": []
    },
    {
      "label": "BM-Monitor: Sync Prices with Master ERP",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:4300/api/sync-to-erp -H 'Content-Type: application/json' -d '{\"erp_api_url\":\"http://localhost:4200/api/market-prices\"}' | json_pp",
      "problemMatcher": []
    }
  ]
}