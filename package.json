{
  "name": "beermood-market-monitor",
  "version": "2.0.0",
  "description": "MOOD Raw Material Price Monitor (Angular 18 + PHP/MySQL for PS.kz)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4300 --open",
    "build": "ng build --configuration production --base-href /BM-Monitor/ && node scripts/copy-to-root.js",
    "build:ps": "node scripts/package-pskz.js",
    "api": "php -S 0.0.0.0:8000 api/index.php",
    "build:deploy": "npm run build && git add . && git commit -m 'feat: update production bundles in root for Plesk' && git push origin main",
    "package:pskz": "node scripts/package-pskz.js",
    "build:root": "ng build --configuration production --base-href /",
    "deploy": "npm run build && git add . && git commit -m \"chore: auto deploy build\" && git push origin main"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "typescript": "~5.5.2"
  }
}